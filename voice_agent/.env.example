# LiveKit Cloud project credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Twilio Elastic SIP Trunk — termination SIP domain.
# HOSTNAME ONLY, no "sip:" prefix. Example: my-trunk.pstn.twilio.com
TWILIO_SIP_TERMINATION_DOMAIN=

# Twilio termination credential list username / password
TWILIO_SIP_AUTH_USERNAME=
TWILIO_SIP_AUTH_PASSWORD=

# US local Twilio number associated with the trunk, full E.164 (+1...)
TWILIO_PHONE_NUMBER=

# Destination mobile, full E.164 (+91...)
DESTINATION_PHONE_NUMBER=

# Populated after running ./create_trunk.sh — paste the ST_... id here
LIVEKIT_OUTBOUND_TRUNK_ID=
